{
  "name": "markovbot",
  "version": "1.0.0",
  "description": "simple chat bot using markov chains",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "label": "tsx src/scripts/label_worker.ts",
    "test": "npm run build && node --test dist/**/*.test.js",
    "verify:generation": "tsx src/scripts/generation_probe.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7",
    "irc-framework": "^4.14.0",
    "natural": "^8.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
